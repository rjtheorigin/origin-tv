<?xml version="1.0" encoding="utf-8"?>
<!-- The phone remote only watches which app is on screen and performs explicit user-requested actions.
     It does not request key filtering, so the physical remote's keys pass through unchanged. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/phone_remote_accessibility_description" />
