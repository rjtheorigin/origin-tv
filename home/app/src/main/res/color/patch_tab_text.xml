<?xml version="1.0" encoding="utf-8"?>
<!-- Focused: dark on the white pill. The open page: white. The rest: dimmed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF101014" />
    <item android:state_activated="true" android:color="#FFFFFFFF" />
    <item android:color="#80FFFFFF" />
</selector>
