<?xml version="1.0" encoding="utf-8"?>
<!-- The PatchWall-style Home: a hero picture top right with the focused programme's details, a tab bar, rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507">

    <ImageView
        android:id="@+id/patch_hero_image"
        android:layout_width="640dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/patch_hero_fade_left"
        android:layout_width="640dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end"
        android:background="@drawable/patch_fade_left" />

    <View
        android:id="@+id/patch_hero_fade_bottom"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@drawable/patch_fade_bottom" />

    <io.github.rjtheorigin.origintv.PatchScrollView
        android:id="@+id/patch_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/patch_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <LinearLayout
                android:id="@+id/patch_hero"
                android:layout_width="match_parent"
                android:layout_height="226dp"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="74dp">

                <TextView
                    android:id="@+id/patch_hero_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/patch_tag_live"
                    android:fontFamily="@font/outfit_medium"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/patch_hero_title"
                    android:layout_width="560dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/patch_hero_meta"
                    android:layout_width="560dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_regular"
                    android:maxLines="1"
                    android:textColor="#C8FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/patch_hero_desc"
                    android:layout_width="500dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_regular"
                    android:lineSpacingExtra="2sp"
                    android:maxLines="3"
                    android:textColor="#9EFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </io.github.rjtheorigin.origintv.PatchScrollView>

    <LinearLayout
        android:id="@+id/patch_top"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/patch_fade_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="30dp">

        <TextView
            android:id="@+id/patch_clock"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/patch_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/patch_btn_inputs"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/patch_icon_bg"
            android:contentDescription="@string/patch_inputs"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_input"
            android:tint="@color/patch_icon_tint" />

        <ImageView
            android:id="@+id/patch_btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/patch_icon_bg"
            android:contentDescription="@string/launcher_settings"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/patch_icon_tint" />
    </LinearLayout>
</FrameLayout>
