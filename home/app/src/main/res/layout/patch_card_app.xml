<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="134dp"
    android:layout_height="80dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/patch_ring"
    android:focusable="true"
    android:padding="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/patch_app_bg"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/patch_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/patch_app_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/patch_app_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/patch_app_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="2"
                android:textColor="#FF26262E"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
