<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets only an app signed with this app's key (the launcher) start the stream server. -->
    <permission
        android:name="io.github.rjtheorigin.joshitv.START_SERVER"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live Channels: Joshi TV writes its own channels and guide into Android's TV database. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Keeps the twice-a-day guide refresh scheduled after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The stream server listens on 127.0.0.1 only, over plain HTTP. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:extractNativeLibs="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The remote's MI button opens this: Joshi TV straight to the channel guide. The app icon opens Home. -->
        <activity-alias
            android:name=".LiveTv"
            android:exported="true"
            android:label="@string/nav_live"
            android:targetActivity=".MainActivity" />
        <!-- Joshi TV as a source in the Live Channels app. -->
        <service
            android:name=".LiveInput"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/live_input" />
        </service>
        <activity
            android:name=".LiveSetupActivity"
            android:exported="true" />
        <service
            android:name=".LiveSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".ServerService"
            android:exported="true"
            android:permission="io.github.rjtheorigin.joshitv.START_SERVER" />
    </application>
</manifest>
