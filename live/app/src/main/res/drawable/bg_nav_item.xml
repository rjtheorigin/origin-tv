<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="13dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><gradient android:angle="0" android:endColor="#003b2f7a" android:startColor="#ff3b2f7a" /><corners android:radius="13dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#00000000" /><corners android:radius="13dp" /></shape>
    </item>
</selector>
